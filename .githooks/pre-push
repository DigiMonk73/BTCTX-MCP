#!/usr/bin/env bash
# BitcoinTX pre-push gate: blocks the push if anything fails.
# Install once with:  make hooks      (or: git config core.hooksPath .githooks)
# Skip in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# The first Python with the dev tools (ruff, pytest): this checkout's .venv,
# the main checkout's (when pushing from a worktree, which has none), then
# desktop/.venv and python3. A Mac build's desktop/.venv has no ruff, so
# taking the first that merely exists failed the push.
PY="${BTCTX_PYTHON:-}"
if [ -z "$PY" ]; then
  main_venv="$(git worktree list --porcelain | sed -n '1s/^worktree //p')/.venv/bin/python"
  for c in .venv/bin/python "$main_venv" desktop/.venv/bin/python python3; do
    if { [ -x "$c" ] || command -v "$c" >/dev/null 2>&1; } && "$c" -c "import ruff, pytest" 2>/dev/null; then
      PY="$c"; break
    fi
  done
  if [ -z "$PY" ]; then
    printf "\n\033[31m✗ pre-push failed: no Python with ruff and pytest\033[0m\n  (install the dev tools, docs/TESTING.md; or set BTCTX_PYTHON; or bypass with: git push --no-verify)\n"
    exit 1
  fi
fi

step() { printf "\n\033[1m▶ %s\033[0m\n" "$1"; }
fail() { printf "\n\033[31m✗ pre-push failed: %s\033[0m\n  (fix it, or bypass with: git push --no-verify)\n" "$1"; exit 1; }

# Branch rules first (AGENTS.md, "Branches"). git passes the pushed refs on
# stdin; there are none when this runs as `make check-fast`.
[ -t 0 ] || .githooks/branch-rules.sh || exit 1

# git hands a hook the variables that name this repository (GIT_DIR in a
# worktree). The tests that build throwaway repositories would inherit them
# and run `git init` on this one, setting core.bare and breaking every
# checkout. git's own advice for a hook that runs git elsewhere: unset them.
unset $(git rev-parse --local-env-vars)

[ -d frontend/dist ] || mkdir -p frontend/dist   # app mounts it at import time

step "Lint (Pyflakes, bare except, modern syntax, function size)"
"$PY" -m ruff check . || fail "ruff"

step "Static compatibility checks"
"$PY" backend/tests/pre_commit_tests.py --no-api >/dev/null || { "$PY" backend/tests/pre_commit_tests.py --no-api | grep -E "✗|FAIL"; fail "static checks"; }

step "Python tests (fast set; CI also runs the slow stress tests)"
"$PY" -m pytest -m "not slow" -q -x -p no:cacheprovider || fail "pytest"

step "Smoke test (real server, temp database)"
"$PY" scripts/smoke_test.py || fail "smoke test"

if [ -d frontend/node_modules ]; then
  step "Frontend lint + type check + unit tests"
  (cd frontend && npm run lint --silent && npx tsc -b && npm test --silent) || fail "frontend"
else
  printf "\n– Frontend checks skipped (run 'npm ci' in frontend/ to enable)\n"
fi

if [ ! -d startos/node_modules ]; then
  printf "\n– StartOS package checks skipped (run 'npm ci' in startos/ to enable)\n"
elif ! (cd startos && start-cli s9pk list-ingredients >/dev/null 2>&1); then
  # The SDK's make rules list the package's files with start-cli, even to type-check
  printf "\n– StartOS package checks skipped (needs start-cli on PATH: the SDK's make runs 'start-cli s9pk list-ingredients')\n"
else
  step "StartOS package: type check + lint + format check + bundle (the SDK's make)"
  (cd startos && rm -rf javascript && make --no-print-directory javascript/index.js \
    && node --no-deprecation scripts/check-manifest.mjs) || fail "startos package"
fi

printf "\n\033[32m✓ All pre-push checks passed\033[0m\n"
