###############################################################################
# BitcoinTX Environment Configuration - Example File                          #
# Copy this file to `.env` and fill in any required values                   #
###############################################################################

# OPTIONAL — key for signing session cookies. Leave unset: a random key is
# generated on first start and kept in .btctx_secret_key next to the database.
# Set it only to share one key across machines, e.g. `openssl rand -hex 32`.
# SECRET_KEY=

# OPTIONAL — comma-separated origins of OTHER sites whose pages may call the
# API with your login cookie (CORS). None by default, and none needed: the app
# serves its own pages, and the Vite dev server (npm run dev) proxies /api.
# CORS_ALLOW_ORIGINS=

# OPTIONAL — path to the SQLite DB (default: backend/bitcoin_tracker.db)
DATABASE_FILE=backend/bitcoin_tracker.db

# OPTIONAL — full SQLAlchemy path if you want to override DATABASE_FILE
# Example for SQLite: sqlite:////absolute/path/to/bitcoin_tracker.db
# DATABASE_URL=

# OPTIONAL — tax timezone used until one is chosen in Settings (default UTC)
# BTCTX_TIMEZONE=America/Chicago

# OPTIONAL — FastAPI debug mode (never in production)
# DEBUG=false
